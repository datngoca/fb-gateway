# Port chạy service
PORT=3000

# Chỉ lắng nghe nội bộ trên VPS (127.0.0.1) để bảo mật tuyệt đối, tránh lộ ra ngoài Internet
HOST=127.0.0.1

# Thông tin Meta Developer App (nếu muốn nạp thêm page sau này)
FB_APP_ID=YOUR_APP_ID_HERE
FB_APP_SECRET=YOUR_APP_SECRET_HERE
REDIRECT_URI=http://localhost:3000/auth/callback
